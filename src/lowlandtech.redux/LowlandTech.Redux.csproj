<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <!-- Target frameworks - support both .NET 8 and 9 -->
	<TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <!-- Enable nullable reference types -->
	<Nullable>enable</Nullable>
    <!-- Company & authorship -->
	<Company>LowlandTech</Company>
	<Authors>wendellmva</Authors>
	<Copyright>Copyright © 2024 LowlandTech</Copyright>

	<!-- Versioning - CI will override these -->
	<VersionPrefix>2025.7.1</VersionPrefix>
	<VersionSuffix Condition="'$(CI_PIPELINE_IID)' != ''">ci.$(CI_PIPELINE_IID)</VersionSuffix>
	<Version Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</Version>
	<Version Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</Version>
	<PackageVersion>$(Version)</PackageVersion>

	<!-- Package metadata -->
	<PackageId>LowlandTech.Redux</PackageId>
	<Title>LowlandTech Redux</Title>
	<Description>Asynchronous Redux-style state management with middleware, undo/redo, and subscription support for .NET.</Description>
	<PackageTags>redux,state management,async,middleware,lowlandtech</PackageTags>
	<RepositoryUrl Condition="'$(CI_PROJECT_URL)' != ''">$(CI_PROJECT_URL)</RepositoryUrl>
	<RepositoryUrl Condition="'$(CI_PROJECT_URL)' == ''">https://gitlab.com/lowlandtech/redux</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageIcon>icon.jpg</PackageIcon>
	<PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Source link and deterministic builds for reproducible packages -->
	<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	<Deterministic>true</Deterministic>
	<EmbedUntrackedSources>true</EmbedUntrackedSources>
	<PublishRepositoryUrl>true</PublishRepositoryUrl>
	<IncludeSymbols>true</IncludeSymbols>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	<IncludeSource>true</IncludeSource>

	<!-- XML documentation -->
	<GenerateDocumentationFile>true</GenerateDocumentationFile>

	<!-- Preserve compilation context for test projects -->
	<PreserveCompilationContext>true</PreserveCompilationContext>

	<!-- Optional: define where your NuGet package will output -->
	<!--<PackageOutputPath>./nupkg</PackageOutputPath>-->
  </PropertyGroup>

  <!-- Package files -->
  <ItemGroup>
	  <None Include="../../icon.jpg" Pack="true" PackagePath="" />
	  <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Release notes pulled from CHANGELOG -->
  <Target Name="ReadReleaseNotes" BeforeTargets="Pack">
	  <ReadLinesFromFile File="../../CHANGELOG.md">
		  <Output TaskParameter="Lines" PropertyName="PackageReleaseNotes" />
	  </ReadLinesFromFile>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.9" />
    <PackageReference Include="System.Reactive" Version="6.0.2" />
  </ItemGroup>

</Project>
